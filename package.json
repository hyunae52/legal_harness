{
  "name": "k-tax-agent-backend",
  "version": "2.0.0",
  "description": "Production Backend for K-Tax Agent (GCE + Supabase + Express)",
  "main": "dist/index.js",
  "bin": {
    "k-tax-agent-backend": "./scripts/hermes-mcp-bridge.mjs",
    "taxlab-legal": "./scripts/hermes-mcp-bridge.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "review": "tsc && node --test tests/*.test.mjs",
    "smoke:mcp": "npm run build && node scripts/mcp-smoke.mjs",
    "mcp:update": "node scripts/mcp-update.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "deploy": "pm2 start ecosystem.config.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@octokit/rest": "^21.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^5.4.2",
    "korean-law-mcp": "4.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "pm2": "^5.4.2",
    "typescript": "^5.5.4"
  }
}
