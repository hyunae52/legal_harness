{
  "manifest_version": "0.3",
  "name": "taxlab-law",
  "display_name": "TaxLab 법령",
  "version": "1.1.0",
  "description": "Claude에서 한국 법령을 조회하고 제출한 초안을 검증합니다.",
  "author": { "name": "TaxLab", "url": "https://law.taxlab.kr/" },
  "homepage": "https://law.taxlab.kr/",
  "privacy_policies": ["https://law.taxlab.kr/#data"],
  "server": {
    "type": "node",
    "entry_point": "server/bridge.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/bridge.mjs"],
      "env": {
        "TAXLAB_SERVER_URL": "https://law.taxlab.kr"
      }
    }
  },
  "compatibility": { "platforms": ["win32", "darwin"], "runtimes": { "node": ">=22" } }
}
