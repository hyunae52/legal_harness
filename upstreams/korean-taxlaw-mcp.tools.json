  {
    "name": "get_tax_document",
    "description": "국세청 문서 1건의 본문을 가져온다. ntst_dcm_id(검색 결과의 ID) 또는 document_number 로 지정한다. 본문은 절(사실관계·질의·회신·주장·판단·결론 등)로 분해되며, 절 분해가 본문을 다 담지 못할 때만 fullText 가 추가된다. 없는 절은 생략된다. 본문을 원본이 주지 않으면 DETAIL_NOT_AVAILABLE 로 알리고 본문을 생성하지 않는다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ntst_dcm_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "국세법령정보시스템 문서 ID(숫자 18자리)"
        },
        "document_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "문서번호. ID 를 모를 때 사용."
        },
        "include_full_text": {
          "default": true,
          "description": "본문 포함 여부",
          "type": "boolean"
        },
        "body_limit": {
          "anyOf": [
            {
              "maximum": 200000,
              "minimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "default": "full",
          "description": "full(기본)=절 전체 | compact=요지·회신·결론만(사실관계·주장·이유 절 생략)",
          "enum": [
            "full",
            "compact"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
  {
    "name": "search_tax_guidance",
    "description": "국세청 행정 해석기준을 검색한다. kind: basic_ruling(기본통칙, 조항 본문 포함) | execution_standard(집행기준, 조항명 목차만 — 원본이 본문 미제공) | notice(고시) | directive(훈령). 기본통칙·집행기준은 law_name 필수(예: '상속세 및 증여세법'). 법규가 아닌 내부 집행기준이다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "description": "조회할 기준 종류",
          "enum": [
            "basic_ruling",
            "execution_standard",
            "notice",
            "directive"
          ],
          "type": "string"
        },
        "law_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "기본통칙·집행기준에는 필수"
        },
        "revision_year": {
          "anyOf": [
            {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "개정연도. 생략하면 최신본"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "조항명·본문 키워드"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "description": "반환 조항 수",
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
