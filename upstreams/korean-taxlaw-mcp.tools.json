          ],
          "default": null,
          "description": "관련 법령명"
        },
        "article": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "관련 조문"
        },
        "match": {
          "default": "all",
          "description": "all=AND(기본), any=OR",
          "enum": [
            "all",
            "any"
          ],
          "type": "string"
        },
        "exclude": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "제외할 낱말(NOT)"
        },
        "date_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "등록일 시작"
        },
        "date_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "등록일 종료"
        },
        "sort": {
          "anyOf": [
            {
              "enum": [
                "latest",
                "oldest",
