PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://law.taxlab.kr
# Existing shared partner key, passed in a header; no default or URL query key.
TAXLAB_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported. Never put a service-role key here.
SUPABASE_ANON_KEY=
# Server-only durable intake RPC. Never pass to MCP clients or the upstream child.
SUPABASE_SERVICE_ROLE_KEY=

# Law Open API's issued OC credential; passed only to the MCP child.
LAW_OC=
LAW_API_PROTOCOL=https
KOREAN_LAW_MCP_CONNECT_TIMEOUT_MS=10000
# Total child connection + tool call budget (max 45000); cleanup holds its slot.
KOREAN_LAW_MCP_TIMEOUT_MS=45000

# Optional NTS/local-tax source provider (zisu17/korean-taxlaw-mcp, reviewed commit).
# Install on the server: python3 scripts/install-taxlaw-mcp.py
# Auto-detected at .runtime/taxlaw/active.json; Python is needed only on the server.
# No NTS API key or paid scraping service is required by this provider.
# TAXLAW_MCP_RELEASE_FILE=/opt/legal_harness/.runtime/taxlaw/active.json
TAXLAW_MCP_CONNECT_TIMEOUT_MS=15000
TAXLAW_MCP_TIMEOUT_MS=45000

# Optional: use a separate installation maintained by the deployment's update cron.
# Default: this project's locked korean-law-mcp package, run by the current Node.
# Command is an executable, not a shell command; args must be a JSON array.
# KOREAN_LAW_MCP_COMMAND=/usr/bin/node
# KOREAN_LAW_MCP_ARGS=["/opt/korean-law-mcp/node_modules/korean-law-mcp/build/index.js","--mode","stdio"]
# KOREAN_LAW_MCP_CWD=/opt/korean-law-mcp

# Deployment cron mode: use this instead of the three manual settings above.
# Bootstrap creates the file; Express reads it when starting.
# KOREAN_LAW_MCP_RELEASE_FILE=/opt/legal_harness/.runtime/korean-law/active.json
# KOREAN_LAW_UPDATE_HEALTH_URL=http://127.0.0.1:3000/health

# Optional upstream request/response budgets (upstream defaults shown).
MCP_MAX_UPSTREAM_REQUESTS=48
MCP_MAX_UPSTREAM_BODY_BYTES=2097152
MCP_MAX_TOTAL_UPSTREAM_BODY_BYTES=8388608
MCP_MAX_TOOL_RESPONSE_CHARS=50000

# Read-only release verification / trusted coordinator configuration.
GITHUB_TOKEN=
GITHUB_OWNER=hyunae52
GITHUB_REPO=legal_harness
GITHUB_BASE_BRANCH=main
GITHUB_OPERATOR=hyunae52

# User-confirmed legal correction data -> draft PR (single process, persistent state).
# No arbitrary executable patch is accepted by this path.
CORRECTION_PR_ENABLED=0
# CORRECTION_STATE_DIR=/var/lib/legal-harness-corrections

# The automatic repair worker is not enabled. Its AGY tools/credential isolation
# and hosted runner evidence adapter must be implemented and verified first.
# No offline heuristic approval, paid fallback, or automatic production activation.
